# IPAM sozlamalari namunasi.
# Nusxa oling:  cp .env.example .env   va qiymatlarni o'zingiznikiga almashtiring.
# .env fayli Git'ga QO'SHILMAYDI — unda parollar va maxfiy kalit saqlanadi.

# --- Asosiy ---
# Serverda albatta False bo'lsin. Faqat o'z kompyuteringizda ishlab chiqishda True.
DJANGO_DEBUG=False
# Yangi kalit yaratish:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=bu-yerga-uzun-tasodifiy-kalit-yozing
# Sayt qaysi nom/IP orqali ochiladi (vergul bilan)
DJANGO_ALLOWED_HOSTS=ipam.example.uz,10.0.0.10
# HTTPS manzili (formalar uchun)
DJANGO_CSRF_TRUSTED_ORIGINS=https://ipam.example.uz

# HTTPS hali sozlanmagan bo'lsa (masalan, ichki tarmoqda sinov uchun) vaqtincha False qiling
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SECURE_COOKIES=True
# Sessiya muddati, soniyalarda (8 soat)
DJANGO_SESSION_AGE=28800

# --- Ma'lumotlar bazasi ---
# sqlite — kichik o'rnatish uchun; postgres — ko'p foydalanuvchili server uchun (tavsiya)
DB_ENGINE=postgres
DB_NAME=ipam
DB_USER=ipam
DB_PASSWORD=kuchli-parol
DB_HOST=localhost
DB_PORT=5432

# --- Zaxira nusxalar ---
IPAM_BACKUP_DIR=/var/backups/ipam
IPAM_BACKUP_KEEP_DAYS=30

# --- Loglar ---
IPAM_LOG_DIR=/var/log/ipam
