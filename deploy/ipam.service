# /etc/systemd/system/ipam.service
[Unit]
Description=IPAM (Django + Gunicorn)
After=network.target postgresql.service
Requires=postgresql.service

[Service]
Type=simple
User=ipam
Group=www-data
WorkingDirectory=/opt/ipam
EnvironmentFile=/opt/ipam/.env
ExecStart=/opt/ipam/.venv/bin/gunicorn -c deploy/gunicorn.conf.py config.wsgi
ExecReload=/bin/kill -s HUP $MAINPID
Restart=on-failure
RestartSec=5

# Xavfsizlik: xizmat faqat kerakli papkalarga yoza oladi
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/var/log/ipam /var/backups/ipam

[Install]
WantedBy=multi-user.target
